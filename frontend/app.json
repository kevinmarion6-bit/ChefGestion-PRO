{
  "expo": {
    "name": "ChefGestion Pro",
    "slug": "chefgestion-pro",
    "version": "1.0.0",
    "updates": {
      "enabled": false
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "scheme": "chefgestion",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chefgestion.pro",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanner vos factures et afficheurs de température",
        "NSPhotoLibraryUsageDescription": "Accéder à vos photos pour l'analyse OCR"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.chefgestion.pro",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Accès photos pour l'analyse OCR"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f401d42a-abdf-4169-b48f-4bbf6408b004"
      }
    }
  }
}
