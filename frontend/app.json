{
  "expo": {
    "name": "ChefGestion Pro",
    "slug": "chefgestion-pro-dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "scheme": "chefgestion",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/63dac985-d0f6-4c0d-9214-691427bfeb72"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chefgestion.pro.dev"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.chefgestion.pro.dev"
    },
    "plugins": [
  "expo-router",
  [
    "expo-camera",
    {
      "cameraPermission": "L'app a besoin d'accéder à la caméra pour scanner les températures et étiquettes."
    }
  ],
  [
    "expo-image-picker",
    {
      "photosPermission": "L'app a besoin d'accéder à vos photos pour importer des documents."
    }
  ],
  [
    "expo-notifications",
    {
      "icon": "./assets/icon.png",
      "color": "#D4AF37"
    }
  ]
],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63dac985-d0f6-4c0d-9214-691427bfeb72"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "chefgestion-pro"
  }
}
