# ─── ChefGestion Backend — Variables d'environnement ────────────────────────
# Copiez ce fichier en .env et remplissez vos valeurs

# Port du serveur (défaut : 3001)
PORT=3001

# ─── SUPABASE ────────────────────────────────────────────────────────────────
# Récupérez ces valeurs dans : supabase.com → votre projet → Settings → API

# URL du projet (ex: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co

# Clé anon/public (pour les opérations authentifiées côté client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service_role (accès admin complet — NE JAMAIS exposer côté client !)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── GEMINI ──────────────────────────────────────────────────────────────────
# Clé API Google Gemini (peut aussi être fournie par l'utilisateur dans l'app)
GEMINI_API_KEY=

# ─── DIVERS ──────────────────────────────────────────────────────────────────
NODE_ENV=development
